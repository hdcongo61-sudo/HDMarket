# HDMarket backend — environment variable reference.
# Copy to .env and fill in real values. Never commit .env itself.
#
# This file was created alongside the Social Commerce Hub; the "Existing"
# section below lists every variable already read by the app (names only,
# no real values ever existed here) so this file is a complete reference
# going forward, not just the new additions.

# ── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001
MONGO_URI=
JWT_SECRET=
JWT_EXPIRE=30d

# ── Cloudinary (product/shop media) ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Firebase (push notifications) ───────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT=

# ── Web push (VAPID) ─────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=

# ── PawaPay (mobile money) ───────────────────────────────────────────────
PAWAPAY_ENABLED=false
PAWAPAY_ENVIRONMENT=sandbox
PAWAPAY_API_TOKEN=
PAWAPAY_CHECKOUT_RETURN_URL=
PAWAPAY_EXCLUSIVE_MODE=false
PAWAPAY_SIGNED_CALLBACKS_REQUIRED=true
PAWAPAY_CONTENT_DIGEST_REQUIRED=true

# ── Misc / tuning ────────────────────────────────────────────────────────
IMAGE_STUDIO_GENERATIVE_AI_ENABLED=false
CHECKOUT_REQUEST_TIMEOUT_MS=
PAYMENT_REQUEST_TIMEOUT_MS=
UPLOAD_REQUEST_TIMEOUT_MS=
REQUEST_TIMEOUT_MS=
SLOW_REQUEST_THRESHOLD_MS=
RATE_LIMIT_WINDOW_MIN=
RATE_LIMIT_MAX=
SELLER_SETTLEMENT_CUTOVER_AT=

# ── Redis (optional — cache/queues degrade gracefully without it) ───────
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=

# ═══════════════════════════════════════════════════════════════════════
# Social Commerce Hub
# ═══════════════════════════════════════════════════════════════════════
# All social_* feature flags default OFF (seeded via
# scripts/seedSocialCommerceFeatureFlags.js) — nothing below is required
# for HDMarket to run normally. See docs/social-commerce.md.

HDMARKET_PUBLIC_URL=https://hdmarket.cg

# AES-256-GCM key used to encrypt SocialConnection provider credentials at
# rest (services/socialCommerce/credentialCrypto.js). Any long random
# string; changing it makes previously-saved credentials undecryptable.
SOCIAL_CREDENTIAL_ENCRYPTION_KEY=

# Shared Meta app secret — used to verify the X-Hub-Signature-256 webhook
# signature for WhatsApp/Instagram/Messenger unless a channel-specific
# *_APP_SECRET below overrides it.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# WhatsApp (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Dialable number for wa.me deep links (distinct from the Phone Number ID
# above, which is an internal Graph API identifier, not a phone number).
SOCIAL_WHATSAPP_DISPLAY_NUMBER=

# Instagram Messaging
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=

# Facebook Messenger
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=

# TikTok Messaging is intentionally NOT configurable here — no provider is
# integrated in this release (see docs/social-commerce.md). The
# SOCIAL_TIKTOK_MESSAGING feature flag stays off; TikTok traffic routes
# through WhatsApp instead.

# Optional tuning
SOCIAL_MAX_REPLIES_PER_MINUTE=6
