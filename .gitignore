# Dependencies
node_modules/

# Environment files (contain real secrets — never commit)
.env
.env.*
!.env.example

# Frontend build output (generated by `vite build`)
frontend/dist/

# Capacitor-synced web assets (generated by `npx cap sync`)
frontend/ios/App/public/
frontend/android/app/src/main/assets/public/

# Backend runtime data
backend/uploads/

# Logs and OS/editor noise
*.log
.DS_Store
